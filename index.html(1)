<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>English Vocabulary Quiz</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            font-family: Arial, sans-serif;
            background: #fff4a8;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 24px;
            color: #333;
        }

        .quiz-container {
            width: 100%;
            max-width: 650px;
            background: #ffffff;
            border-radius: 28px;
            padding: 36px 28px;
            text-align: center;
            box-shadow: 0 12px 30px rgba(80, 70, 20, 0.18);
        }

        .title {
            margin: 0 0 8px;
            font-size: 36px;
            color: #222;
        }

        .subtitle {
            margin: 0 0 26px;
            color: #777;
            font-size: 16px;
        }

        .progress {
            font-size: 15px;
            font-weight: bold;
            color: #8a7500;
            margin-bottom: 18px;
        }

        .word-card {
            background: #fff9d6;
            border: 3px solid #f4d83d;
            border-radius: 22px;
            padding: 28px 18px;
            margin-bottom: 24px;
        }

        .question {
            margin: 0 0 10px;
            font-size: 18px;
            color: #555;
        }

        .word {
            margin: 0;
            font-size: 48px;
            font-weight: 800;
            color: #222;
            letter-spacing: 1px;
        }

        .instruction {
            margin: 0 0 18px;
            font-size: 17px;
            font-weight: bold;
        }

        .answers {
            display: grid;
            grid-template-columns: 1fr;
            gap: 12px;
        }

        .answer-btn {
            width: 100%;
            padding: 17px 18px;
            border: 2px solid #e6d34a;
            border-radius: 16px;
            background: #fff;
            color: #333;
            font-size: 20px;
            font-weight: bold;
            cursor: pointer;
            transition: 0.15s;
        }

        .answer-btn:hover {
            background: #fff4a8;
            transform: translateY(-2px);
        }

        .answer-btn:disabled {
            cursor: default;
            transform: none;
        }

        .feedback {
            min-height: 32px;
            margin: 22px 0 8px;
            font-size: 20px;
            font-weight: bold;
        }

        .next-btn {
            display: none;
            margin: 16px auto 0;
            padding: 14px 28px;
            border: none;
            border-radius: 14px;
            background: #f4cf24;
            color: #222;
            font-size: 18px;
            font-weight: bold;
            cursor: pointer;
        }

        .next-btn:hover {
            background: #e9c116;
        }

        .score {
            display: none;
            font-size: 25px;
            font-weight: bold;
            margin-top: 22px;
        }

        .celebration {
            display: none;
            font-size: 90px;
            margin-top: 12px;
            animation: pop 0.6s ease;
        }

        .hint {
            margin-top: 10px;
            font-size: 18px;
            font-weight: bold;
            color: #8a6500;
        }

        @keyframes pop {
            0% {
                transform: scale(0.4);
                opacity: 0;
            }

            70% {
                transform: scale(1.15);
            }

            100% {
                transform: scale(1);
                opacity: 1;
            }
        }

        .restart-btn {
            display: none;
            margin: 16px auto 0;
            padding: 14px 28px;
            border: none;
            border-radius: 14px;
            background: #333;
            color: white;
            font-size: 18px;
            font-weight: bold;
            cursor: pointer;
        }

        @media (min-width: 600px) {
            .answers {
                grid-template-columns: 1fr 1fr;
            }
        }
    </style>
</head>

<body>

    <main class="quiz-container">

        <h1 class="title">Vocabulary Quiz</h1>

        <p class="subtitle">
            Choose the synonym of each word.
        </p>

        <div class="progress" id="progress">
            Question 1 of 5
        </div>

        <section class="word-card">

            <p class="question">
                What is the synonym of:
            </p>

            <h2 class="word" id="word">
                effort
            </h2>

        </section>

        <p class="instruction">
            Choose the correct answer.
        </p>

        <div class="answers" id="answers"></div>

        <div class="feedback" id="feedback"></div>

        <div class="hint" id="hint"></div>

        <button
            class="next-btn"
            id="nextButton"
            onclick="nextQuestion()">
            Next →
        </button>

        <div class="score" id="score"></div>

        <div class="celebration" id="celebration">
            🥳
        </div>

        <button
            class="restart-btn"
            id="restartButton"
            onclick="restartQuiz()">
            Try Again
        </button>

    </main>


    <script>

        /* =========================
           QUIZ DATA
           ========================= */

        const quizData = [

            {
                word: "effort",
                meaning: "노력",
                answer: "attempt",
                choices: [
                    "attempt",
                    "result",
                    "reason",
                    "habit"
                ]
            },

            {
                word: "improve",
                meaning: "향상시키다, 개선하다",
                answer: "enhance",
                choices: [
                    "enhance",
                    "reduce",
                    "repeat",
                    "remove"
                ]
            },

            {
                word: "valuable",
                meaning: "가치 있는",
                answer: "worthwhile",
                choices: [
                    "worthwhile",
                    "ordinary",
                    "simple",
                    "empty"
                ]
            },

            {
                word: "prepare",
                meaning: "준비하다",
                answer: "get ready",
                choices: [
                    "get ready",
                    "give up",
                    "look after",
                    "find out"
                ]
            },

            {
                word: "convenient",
                meaning: "편리한",
                answer: "handy",
                choices: [
                    "handy",
                    "difficult",
                    "distant",
                    "expensive"
                ]
            }

        ];


        /* =========================
           QUIZ VARIABLES
           ========================= */

        let currentQuestion = 0;

        let score = 0;

        let answered = false;


        /* =========================
           SHUFFLE
           ========================= */

        function shuffle(array) {

            return [...array].sort(
                () => Math.random() - 0.5
            );

        }


        /* =========================
           LOAD QUESTION
           ========================= */

        function loadQuestion() {

            const quiz =
                quizData[currentQuestion];


            // 진행 상황
            document.getElementById("progress").innerText =
                `Question ${currentQuestion + 1} of ${quizData.length}`;


            // 단어
            document.getElementById("word").innerText =
                quiz.word;


            // 답안 초기화
            const answersContainer =
                document.getElementById("answers");

            answersContainer.innerHTML = "";


            // 피드백 초기화
            document.getElementById("feedback").innerText = "";

            document.getElementById("hint").innerText = "";


            // Next 버튼 숨기기
            document.getElementById("nextButton")
                .style.display = "none";


            // 축하 표시 숨기기
            document.getElementById("celebration")
                .style.display = "none";


            // 문제 다시 풀 수 있도록 설정
            answered = false;


            // 보기 섞기
            shuffle(quiz.choices).forEach(choice => {

                const button =
                    document.createElement("button");


                button.className =
                    "answer-btn";


                button.innerText =
                    choice;


                button.onclick = () =>
                    checkAnswer(choice, button);


                answersContainer.appendChild(button);

            });

        }


        /* =========================
           CHECK ANSWER
           ========================= */

        function checkAnswer(
            selectedAnswer,
            selectedButton
        ) {

            // 이미 답을 선택했다면 다시 실행하지 않음
            if (answered) return;

            answered = true;


            const quiz =
                quizData[currentQuestion];


            const buttons =
                document.querySelectorAll(".answer-btn");


            // 모든 버튼 비활성화
            buttons.forEach(button => {

                button.disabled = true;


                // 정답 표시
                if (
                    button.innerText ===
                    quiz.answer
                ) {

                    button.style.backgroundColor =
                        "#dff5d8";

                    button.style.borderColor =
                        "#72b85a";

                }

            });


            /* =========================
               CORRECT
               ========================= */

            if (
                selectedAnswer ===
                quiz.answer
            ) {

                score++;


                document.getElementById(
                    "feedback"
                ).innerText =
                    "Correct! Well done!";


                document.getElementById(
                    "feedback"
                ).style.color =
                    "#4d8c35";

            }


            /* =========================
               INCORRECT
               ========================= */

            else {

                document.getElementById(
                    "feedback"
                ).innerText =
                    `Incorrect. The answer is "${quiz.answer}".`;


                document.getElementById(
                    "feedback"
                ).style.color =
                    "#c44b4b";


                // 단어 뜻 Hint 표시
                document.getElementById(
                    "hint"
                ).innerText =
                    `💡 Hint: ${quiz.word} = ${quiz.meaning}`;


                // 사용자가 선택한 오답 표시
                selectedButton.style.backgroundColor =
                    "#ffe0e0";


                selectedButton.style.borderColor =
                    "#e07070";

            }


            /* =========================
               NEXT QUESTION / FINAL
               ========================= */

            if (
                currentQuestion <
                quizData.length - 1
            ) {

                // 아직 문제가 남아 있으면 Next 버튼
                document.getElementById(
                    "nextButton"
                ).style.display =
                    "block";

            }

            else {

                // 최종 점수
                document.getElementById(
                    "score"
                ).innerText =
                    `Your score: ${score} / ${quizData.length}`;


                document.getElementById(
                    "score"
                ).style.display =
                    "block";


                /* =========================
                   PERFECT SCORE
                   ========================= */

                if (
                    score ===
                    quizData.length
                ) {

                    document.getElementById(
                        "celebration"
                    ).style.display =
                        "block";


                    document.getElementById(
                        "feedback"
                    ).innerText =
                        "Perfect! You got everything right!";


                    document.getElementById(
                        "feedback"
                    ).style.color =
                        "#d69b00";

                }


                // 다시하기 버튼
                document.getElementById(
                    "restartButton"
                ).style.display =
                    "block";

            }

        }


        /* =========================
           NEXT QUESTION
           ========================= */

        function nextQuestion() {

            currentQuestion++;

            loadQuestion();

        }


        /* =========================
           RESTART QUIZ
           ========================= */

        function restartQuiz() {

            currentQuestion = 0;

            score = 0;


            document.getElementById(
                "score"
            ).style.display =
                "none";


            document.getElementById(
                "restartButton"
            ).style.display =
                "none";


            loadQuestion();

        }


        /* =========================
           START QUIZ
           ========================= */

        loadQuestion();

    </script>

</body>

</html>
